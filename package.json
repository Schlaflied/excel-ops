{
  "name": "excel-ops-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-facing MCP adapter for the Excel-Ops deterministic Python CLI",
  "bin": {
    "excel-ops-mcp": "mcp/server.mjs"
  },
  "scripts": {
    "test:mcp": "node --test tests/mcp.test.mjs",
    "test:mcp-integration": "node --test tests/mcp-cli.integration.test.mjs",
